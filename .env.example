# AutoValor CO - environment template.
# Copy to .env and adjust. Never commit .env.
# Variables are read by src/autovalor/config.py with the AUTOVALOR_ prefix, except
# AUTOVALOR_BRONZE_GLOB, which dbt reads on its own (see the note below it).

# --- Paths ----------------------------------------------------------------- #
# Root of the data lake; bronze/silver/gold are created underneath it.
AUTOVALOR_DATA_DIR=./data
# DuckDB file used by dbt for the silver and gold layers.
AUTOVALOR_DUCKDB_PATH=./data/autovalor.duckdb
# Parquet glob for the listing-detail layer, read by dbt the same way as bronze below.
# A sibling root of bronze/ rather than a directory inside it: bronze is read as one
# union of a single schema, and a second schema under that glob would be unioned into it.
AUTOVALOR_DETAIL_GLOB=data/detail/**/*.parquet
# Parquet glob that dbt reads the bronze source from (dbt/models/sources.yml).
# Unlike every other variable here this one is NOT a config.py field: dbt resolves it
# with env_var() straight from the process environment, so a value written only into
# .env will not reach it — export it in the shell that runs dbt. It has to agree with
# AUTOVALOR_DATA_DIR above; the default below matches the default data directory.
AUTOVALOR_BRONZE_GLOB=data/bronze/**/*.parquet

# --- MLflow ---------------------------------------------------------------- #
# MLflow 3 refuses the filesystem backend (file:./mlruns), so this is a local SQLite
# database. Artifacts still land in ./mlartifacts.
AUTOVALOR_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
AUTOVALOR_MLFLOW_EXPERIMENT=autovalor-baseline

# --- Scraping (polite by default, see robots.txt) -------------------------- #
# Identifiable user-agent with a contact URL, as required by the data rules.
AUTOVALOR_SCRAPER_USER_AGENT=AutoValorCO/0.1 (+https://github.com/JoseRomo16/AutoValorCo; research project)
AUTOVALOR_SCRAPER_MIN_DELAY_SECONDS=2.0
AUTOVALOR_SCRAPER_MAX_DELAY_SECONDS=6.0
AUTOVALOR_SCRAPER_MAX_PAGES=50
AUTOVALOR_SCRAPER_RESPECT_ROBOTS=true
# Set to true on networks that inspect TLS (corporate proxy, some antivirus):
# certificates are then verified against the OS store instead of certifi.
AUTOVALOR_USE_SYSTEM_CERTS=false

# --- API ------------------------------------------------------------------- #
AUTOVALOR_API_HOST=0.0.0.0
AUTOVALOR_API_PORT=8000
AUTOVALOR_LOG_LEVEL=INFO
# Model served by /predict and /explain; "unreleased" until F2 closes.
AUTOVALOR_SERVED_MODEL_VERSION=unreleased
